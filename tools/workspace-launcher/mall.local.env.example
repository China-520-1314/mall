# Copy this file to mall.local.env and fill in the credentials of your existing MySQL.
# The local file is ignored by the launcher repository and is never required in Git.
# If a password contains spaces, #, &, or =, wrap the whole value in double quotes.
MALL_DATASOURCE_URL=jdbc:mysql://localhost:3306/mall?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MALL_DATASOURCE_USERNAME=root
MALL_DATASOURCE_PASSWORD=<your-local-mysql-password>
